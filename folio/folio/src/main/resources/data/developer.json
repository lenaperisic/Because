      "pages": 64, "size": "3.8 MB", "updated": "Oct 20",
      "scanned": false, "signed": false, "filled": false, "redacted": false, "ocr": false, "annotated": false,
      "summary": [
        "Faster VACUUM and lower memory use.",
        "Incremental backups with pg_basebackup.",
        "JSON_TABLE and new SQL/JSON functions."
      ],
      "changes": [],
      "blocks": [
        { "type": "letterhead", "org": "PostgreSQL Global Development Group", "sub": "Release notes" },
        { "type": "title", "text": "PostgreSQL 17 · What's new" },
        { "type": "h2", "text": "Performance" },
        { "type": "p", "text": "A new memory structure for VACUUM uses up to 20 times less memory, and queries with IN lists on B-tree indexes are faster." },
        { "type": "h2", "text": "Backups" },
        { "type": "code", "lines": [
          "pg_basebackup --incremental=backup_manifest -D /backup/inc1",
          "pg_combinebackup /backup/full /backup/inc1 -o /restore"
        ] },
        { "type": "h2", "text": "SQL/JSON" },
        { "type": "p", "text": "The JSON_TABLE function turns JSON into rows and columns, so JSON documents can be joined with regular tables." }
      ]
