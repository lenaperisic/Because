# Copy to .env.local and fill in.

# Perplexity (pplx-...): model for the interview while there is no Anthropic key
PERPLEXITY_API_KEY=

# Anthropic (or empty if you are logged in with `ant auth login`)
ANTHROPIC_API_KEY=
# Interview model (default claude-opus-5-5)
INTERVIEW_MODEL=claude-opus-5-5

# PostHog project token (phc_...): seed and write-back (capture)
POSTHOG_KEY=
# Host for sending events: https://eu.i.posthog.com or https://us.i.posthog.com
POSTHOG_HOST=https://eu.i.posthog.com

# PostHog personal API key (phx_...) with Query Read permission: reading events
POSTHOG_PERSONAL_KEY=
POSTHOG_PROJECT_ID=
# Host for the API: https://eu.posthog.com or https://us.posthog.com
POSTHOG_API_HOST=https://eu.posthog.com

# Optional: events ingested before this time are ignored (default 2026-11-08T12:30:00Z, the switch to English)
# POSTHOG_IGNORE_BEFORE=
