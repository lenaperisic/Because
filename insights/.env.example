# Kopirajte u .env.local i popunite.

# Perplexity (pplx-...): model za intervju dok nema Anthropic ključa
PERPLEXITY_API_KEY=

# Anthropic (ili prazno ako ste ulogovani preko `ant auth login`)
ANTHROPIC_API_KEY=
# Model za intervju (podrazumevano claude-opus-5-5)
INTERVIEW_MODEL=claude-opus-5-5

# PostHog project token (phc_...): seed i upis nazad (capture)
POSTHOG_KEY=
# Host za slanje događaja: https://eu.i.posthog.com ili https://us.i.posthog.com
POSTHOG_HOST=https://eu.i.posthog.com

# PostHog personal API key (phx_...) sa dozvolom Query Read: čitanje događaja
POSTHOG_PERSONAL_KEY=
POSTHOG_PROJECT_ID=
# Host za API: https://eu.posthog.com ili https://us.posthog.com
POSTHOG_API_HOST=https://eu.posthog.com
